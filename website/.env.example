# ── 必填（在 Vercel 项目设置里配置）────────────────────────────
# Supabase 项目 URL（Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase anon public key（Settings → API，可公开，用于 RLS 读取）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase service_role key（Settings → API，绝不可公开，只存 Vercel 服务端）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 可选：官方站点域名（用于生成下载/反馈里的回链）
NEXT_PUBLIC_SITE_URL=https://runjam.app
