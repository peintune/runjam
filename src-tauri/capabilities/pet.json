{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet",
  "description": "Capabilities for the desktop-pet windows: the always-on-top launcher icon (pet-icon) and its Q&A popup (pet-chat). These are top-level windows, not child webviews.",
  "windows": ["pet-icon", "pet-chat"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:default",
    "opener:default",
    "dialog:allow-open"
  ]
}